@article{breakstone_try_2014,
	title = {Try, {Try}, {Try} {Again}: {The} {Process} of {Designing} {New} {History} {Assessments}},
	volume = {42},
	issn = {0093-3104, 2163-1654},
	shorttitle = {Try, {Try}, {Try} {Again}},
	url = {http://www.tandfonline.com/doi/abs/10.1080/00933104.2014.965860},
	doi = {10.1080/00933104.2014.965860},
	abstract = {This article considers the design process for new formative history assessments. Over the course of 3 years, my colleagues from the Stanford History Education Group and I designed, piloted, and revised dozens of History Assessments of Thinking (HATs). As we created HATs, we sought to gather information about their cognitive validity, the relationship between the constructs targeted by the assessments, and the cognitive processes students used to answer them. Three case studies trace the development of different HATs through analyses of draft assessments, student responses, and think-aloud protocols. Design principles speciﬁc to formative history assessments emerged from these analyses: (1) assessments must be historically accurate, (2) assessments must target speciﬁc historical constructs, (3) assessment structure must align with targeted constructs, (4) assessments must yield useful information for teachers, and (5) pilot data are indispensable for reﬁning HATs. These ﬁnding suggest the need for increased attention on the construction and validation of new assessment materials for the history classroom.},
	language = {en},
	number = {4},
	urldate = {2026-08-21},
	journal = {Theory \& Research in Social Education},
	author = {Breakstone, Joel},
	month = oct,
	year = {2014},
	pages = {453--485},
	annote = {
},
	annote = {史實正確性（historical accuracy）文件本身必須和問題相匹配。(文件能正確且明確推論出答案而非模稜兩可)Presentism（以當代價值直接套用過去）要讓受測者進入歷史情境，而非在現代道德制高點批判Flexible use of evidence = 能夠根據不同 historical claims，合理地重新解釋與運用同一份 evidence，而不是把 evidence 當成只能支持單一結論。

出題很重要會決定是否能測出historical thinking能力幾個結論的原則1.Historically Accurate2.Target Specific Constructs (做一個能測歷史思維的題目，而不是判斷true or false)3.Structure Aligns With Construct(題目設計不要讓受測者被construct-irrelevant variance無關能力影響)4.Pilot Data Are Indispensable 要做pilot很重要5.Yield Information About Student Thinking 揭露學生思考所以認知效度（cognitive validity）很重要 評量所鎖定的構念（constructs），是否與學生回答時實際使用的認知歷程（cognitive processes）相符。這種關係稱為認知效度（cognitive validity）proficiency={\textgreater}熟練度 例如脈絡化能力熟練度
},
