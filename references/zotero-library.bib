@incollection{van_boxtel_historical_2018,
	title = {Historical {Reasoning}: {Conceptualizations} and {Educational} {Applications}},
	url = {https://doi.org/10.1002/9781119100812.ch6},
	doi = {10.1002/9781119100812.ch6},
	booktitle = {The {Wiley} {International} {Handbook} of {History} {Teaching} and {Learning}},
	publisher = {Wiley-Blackwell},
	author = {van Boxtel, Carla and van Drie, Jannet},
	editor = {Metzger, Scott Alan and Harris, Lauren McArthur},
	year = {2018},
	pages = {149--176},
	annote = {AI整理分類\_2026-07-03｜精密文獻筆記MetadataTitle: Historical Reasoning: Conceptualizations and Educational ApplicationsCreators: Carla van Boxtel; Jannet van DrieYear / date: 2018Venue: The Wiley International Handbook of History Teaching and LearningZotero item key: ZB5Z8JZABibTeX key: vanboxtel\_historical\_2018DOI: 10.1002/9781119100812.ch6AI 整理分類: 歷史推理 / 歷史思維 / 教育應用PDF / Source Status已附上 UvA-DARE 可取得的正式 PDF。一句話定位這章把 historical reasoning 定義為整合性、社會情境化的活動：學生透過問題、脈絡化、時間與因果關係、概念使用、證據與論證來形成可辯護的歷史結論。快速檢索 hookshistorical reasoninghistorical thinkingcontextualizationmetahistorical conceptssubstantive knowledgeargumentationsource-based inquirywhole-class discussion可引用主張可引用主張位置/來源脈絡證據性質建議用途Historical reasoning 是一組連貫活動，而不是單一技能；它以形成可辯護的歷史結論為目標。Discussion理論定義核心構念界定學生需要同時使用 substantive concepts 與 metahistorical concepts，並以史料證據建立論證。Conceptualization概念架構任務與評量設計明示教學、全班討論、authentic inquiry tasks 和多史料任務能支持歷史推理。Educational applications教學應用介入設計原理既有研究較常看史料作為證據，較少細看學生如何推理變遷、延續、比較與因果。Discussion研究缺口研究問題定位章節與核心概念摘要Conceptual Starting Point作者整理 historical reasoning、historical thinking、historical argumentation 等相鄰概念。重點是 historical reasoning 不只是會背史實，也不是單純批判史料；它是學生把問題、概念、證據與論證串成結論的過程。Components of Historical Reasoning核心活動包含提出歷史問題、使用 substantive historical concepts、使用 metahistorical concepts、脈絡化、建構時間與因果關係、比較相似與差異、分析史料、以證據支持主張、評估論點與反論點。Resources That Shape Reasoning歷史推理品質受學生既有史實知識、對二階概念的理解、對歷史知識性質的認識、閱讀/寫作能力、興趣、身份認同與課堂互動影響。這對 AI 系統很重要，因為錯誤不一定只是知識缺口，也可能是 epistemic belief 或論證策略問題。Educational Applications作者指出有效教學包含 explicit instruction、source-based inquiry、writing tasks、visual representations、以及 whole-class discussion。任務的 inquiry question 會決定被引出的 reasoning 類型，因此問題設計必須對準學習目標。Assessment Implications若把 historical reasoning 當成高層次能力，就需要細緻評量工具。評量不能只看答案正誤，還要看學生如何形成結論：是否脈絡化、是否建構因果、是否比較、是否使用證據、是否處理反論點。Use For Histosphere這篇可直接支撐 Histosphere 的核心評量架構。AI persona 對話、EBL 任務和錯誤回饋都可以圍繞 historical reasoning components：當學生回答不完整時，系統可追問史料依據、時間序列、因果鏈、背景脈絡或替代觀點。Limitations這是 handbook chapter / 理論綜述，強在概念整合與教學啟示；不是單一實驗研究。引用時應用於理論框架、構念操作化和設計原理，不宜單獨作為系統有效性的因果證據。與 Histosphere2 / 論文主題的連結可作為 Histosphere 的 historical reasoning 主框架。可把 task\_judgement 的評分維度拆成 contextualization、evidence、causation、comparison、argumentation。可支撐你的 EBL 設計：錯誤回饋要引導學生重建推理過程，而不是只修正答案。舊 note 保留舊 note ZVTKRZIR舊 note title: User-provided PDF: https://scispace.com/pdf/historical-reasoning-conceptualizations-and-educational-47wfr74n7n.pdfUser-provided PDF: https://scispace.com/pdf/historical-reasoning-conceptualizations-and-educational-47wfr74n7n.pdf},
	annote = {User-provided PDF: https://scispace.com/pdf/historical-reasoning-conceptualizations-and-educational-47wfr74n7n.pdf},
