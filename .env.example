# Frontend Environment Variables
# 複製此檔案為 .env 並填入您的值

# Supabase (Frontend - 使用 anon key，非 service role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI Backend
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_REPOSITORY=supabase
HISTOSPHERE_ADMIN_KEY=change-this-local-admin-key

# LLM runtime via LiteLLM
LLM_PROVIDER=litellm
# Formal thesis runtime locks this single provider/model for every participant.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Retained only for isolated benchmarks or legacy configuration; formal runtime ignores provider fallback.
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
# Optional: set this for local OpenAI-compatible models or a GPT OAuth proxy.
LLM_API_BASE=
# Optional: generic API key for OpenAI-compatible/proxy providers.
LLM_API_KEY=
# Provider-specific keys can also be read by LiteLLM.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=minimal
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_ENABLE_THINKING=false
NVIDIA_REASONING_BUDGET=4096
COHERE_API_KEY=
COHERE_LLM_MODEL=cohere/command-a-plus-05-2026
LLM_REJECTION_LOG_PATH=.dev-logs/llm-generation-rejections.jsonl

# Backend Supabase service role
SUPABASE_URL=
# Backend JWT verification key. Local development may reuse VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Backward-compatible local alias. Prefer SUPABASE_SERVICE_ROLE_KEY for new setups.
SUPABASE_KEY=
