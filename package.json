{
  "name": "ai-persona-chat-nuxt3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:full": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -StartSupabase -KillExisting",
    "dev:full:supabase": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -StartSupabase -KillExisting",
    "dev:cleanup": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "dev:cleanup:supabase": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1 -Supabase",
    "dev:repair:supabase-ports": "powershell -ExecutionPolicy Bypass -File ./scripts/release-supabase-ports.ps1",
    "supabase:start": "supabase start -x edge-runtime,imgproxy,logflare,mailpit,realtime,vector",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:frontend:unit": "node scripts/tests/run-frontend-unit-tests.mjs",
    "test:backend": "cd backend && python -m pytest -q",
    "test:supabase:schema": "node scripts/tests/check-supabase-schema.mjs",
    "test:runtime:smoke": "node scripts/tests/check-runtime-smoke.mjs",
    "test:quality:code": "pnpm test:frontend:unit && pnpm test:backend && pnpm build",
    "test:quality": "pnpm test:quality:code && pnpm test:supabase:schema && pnpm test:runtime:smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "gsap": "^3.15.0",
    "nuxt": "^4.2.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/icon": "^2.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "jimp": "0.22.10",
    "supabase": "2.109.1",
    "typescript": "^5.9.3"
  }
}
