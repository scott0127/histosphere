{
  "name": "ai-persona-chat-nuxt3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:full": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -StartSupabase -KillExisting",
    "dev:full:supabase": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -StartSupabase -KillExisting",
    "dev:cleanup": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "dev:cleanup:supabase": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1 -Supabase",
    "supabase:start": "npx -y supabase@latest start",
    "supabase:stop": "npx -y supabase@latest stop",
    "supabase:status": "npx -y supabase@latest status",
    "supabase:reset": "npx -y supabase@latest db reset",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "gsap": "^3.15.0",
    "nuxt": "^4.2.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/icon": "^2.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "jimp": "0.22.10",
    "typescript": "^5.9.3"
  }
}
